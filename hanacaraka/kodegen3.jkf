ꦥꦿꦺꦴꦒꦿꦩ꧀ CodegenRuntime;
ꦮꦂ
  kode : ꦠꦼꦩ꧀ꦧꦸꦁ;
  namaFile : ꦠꦼꦩ꧀ꦧꦸꦁ;
  namaOut : ꦠꦼꦩ꧀ꦧꦸꦁ;
  out : ꦠꦼꦩ꧀ꦧꦸꦁ;
  i : ꦲꦁꦏ;
  panjang : ꦲꦁꦏ;
  curToken : ꦲꦁꦏ;
  curText : ꦠꦼꦩ꧀ꦧꦸꦁ;
  huruf : ꦠꦼꦩ꧀ꦧꦸꦁ;
  kata : ꦠꦼꦩ꧀ꦧꦸꦁ;
  temp : ꦲꦁꦏ;
  namaProg : ꦠꦼꦩ꧀ꦧꦸꦁ;

ꦥ꦳ꦸꦁꦱꦶ ApaHuruf(h : ꦠꦼꦩ꧀ꦧꦸꦁ) : ꦲꦁꦏ;
ꦩꦸꦭꦶ
  temp := Kode(h);
  ꦪꦺꦤ꧀ temp >= 65 ꦩꦺꦴꦁꦏꦺꦴ
    ꦪꦺꦤ꧀ temp <= 90 ꦩꦺꦴꦁꦏꦺꦴ
      ApaHuruf := 1
    ꦭꦶꦪꦤꦺ
      ꦪꦺꦤ꧀ temp >= 97 ꦩꦺꦴꦁꦏꦺꦴ
        ꦪꦺꦤ꧀ temp <= 122 ꦩꦺꦴꦁꦏꦺꦴ
          ApaHuruf := 1
        ꦭꦶꦪꦤꦺ
          ApaHuruf := 0
      ꦭꦶꦪꦤꦺ
        ApaHuruf := 0
  ꦭꦶꦪꦤꦺ
    ꦪꦺꦤ꧀ temp >= 43008 ꦩꦺꦴꦁꦏꦺꦴ
      ꦪꦺꦤ꧀ temp <= 43135 ꦩꦺꦴꦁꦏꦺꦴ
        ApaHuruf := 1
      ꦭꦶꦪꦤꦺ
        ApaHuruf := 0
    ꦭꦶꦪꦤꦺ
      ꦪꦺꦤ꧀ temp = 95 ꦩꦺꦴꦁꦏꦺꦴ
        ApaHuruf := 1
      ꦭꦶꦪꦤꦺ
        ApaHuruf := 0;
ꦫꦩ꧀ꦥꦸꦁ;

ꦥ꦳ꦸꦁꦱꦶ ApaAngka(h : ꦠꦼꦩ꧀ꦧꦸꦁ) : ꦲꦁꦏ;
ꦩꦸꦭꦶ
  temp := Kode(h);
  ꦪꦺꦤ꧀ temp >= 48 ꦩꦺꦴꦁꦏꦺꦴ
    ꦪꦺꦤ꧀ temp <= 57 ꦩꦺꦴꦁꦏꦺꦴ
      ApaAngka := 1
    ꦭꦶꦪꦤꦺ
      ApaAngka := 0
  ꦭꦶꦪꦤꦺ
    ApaAngka := 0;
ꦫꦩ꧀ꦥꦸꦁ;

ꦥꦿꦺꦴꦱꦺꦢꦸꦂ Emit(s : ꦠꦼꦩ꧀ꦧꦸꦁ);
ꦩꦸꦭꦶ
  out := Gabung(out, s);
  out := Gabung(out, ' ');
ꦫꦩ꧀ꦥꦸꦁ;

ꦥꦿꦺꦴꦱꦺꦢꦸꦂ EmitLn(s : ꦠꦼꦩ꧀ꦧꦸꦁ);
ꦩꦸꦭꦶ
  out := Gabung(out, s);
  out := Gabung(out, Chr(10));
ꦫꦩ꧀ꦥꦸꦁ;

ꦥꦿꦺꦴꦱꦺꦢꦸꦂ EmitRuntime;
ꦩꦸꦭꦶ
  EmitLn('{$mode objfpc}{$H+}');
  EmitLn('uses SysUtils, Classes;');
  EmitLn('function Panjang(s: string): Integer; begin Result := Length(s); end;');
  EmitLn('function Kode(s: string): Integer; begin if s = '''' then Result := 0 else Result := Ord(s[1]); end;');
  EmitLn('function Ambil(s: string; idx: Integer): string; begin if (idx < 1) or (idx > Length(s)) then Result := '''' else Result := s[idx]; end;');
  EmitLn('function Gabung(a, b: string): string; begin Result := a + b; end;');
  EmitLn('function BacaFile(nama: string): string;');
  EmitLn('var F: TextFile; L: string; S: string;');
  EmitLn('begin S := ''''; AssignFile(F, nama); {$I-} Reset(F); {$I+} if IOResult = 0 then begin while not Eof(F) do begin ReadLn(F, L); S := S + L + LineEnding; end; CloseFile(F); end; Result := S; end;');
  EmitLn('procedure TulisFile(nama, isi: string);');
  EmitLn('var F: TextFile;');
  EmitLn('begin AssignFile(F, nama); Rewrite(F); Write(F, isi); CloseFile(F); end;');
  EmitLn('function Param(idx: Integer): string; begin if (idx >= 0) and (idx <= ParamCount) then Result := ParamStr(idx) else Result := ''''; end;');
  EmitLn('function JumlahParam(): Integer; begin Result := ParamCount; end;');
ꦫꦩ꧀ꦥꦸꦁ;

ꦥ꦳ꦸꦁꦱꦶ KeywordKeToken(k : ꦠꦼꦩ꧀ꦧꦸꦁ) : ꦲꦁꦏ;
ꦩꦸꦭꦶ
  ꦪꦺꦤ꧀ k = 'ꦩꦸꦭꦶ' ꦩꦺꦴꦁꦏꦺꦴ
    KeywordKeToken := 10
  ꦭꦶꦪꦤꦺ
    ꦪꦺꦤ꧀ k = 'ꦫꦩ꧀ꦥꦸꦁ' ꦩꦺꦴꦁꦏꦺꦴ
      KeywordKeToken := 11
    ꦭꦶꦪꦤꦺ
      ꦪꦺꦤ꧀ k = 'ꦠꦸꦭꦶꦱ꧀' ꦩꦺꦴꦁꦏꦺꦴ
        KeywordKeToken := 20
      ꦭꦶꦪꦤꦺ
        ꦪꦺꦤ꧀ k = 'ꦪꦺꦤ꧀' ꦩꦺꦴꦁꦏꦺꦴ
          KeywordKeToken := 12
        ꦭꦶꦪꦤꦺ
          ꦪꦺꦤ꧀ k = 'ꦩꦺꦴꦁꦏꦺꦴ' ꦩꦺꦴꦁꦏꦺꦴ
            KeywordKeToken := 13
          ꦭꦶꦪꦤꦺ
            ꦪꦺꦤ꧀ k = 'ꦭꦶꦪꦤꦺ' ꦩꦺꦴꦁꦏꦺꦴ
              KeywordKeToken := 14
            ꦭꦶꦪꦤꦺ
              ꦪꦺꦤ꧀ k = 'ꦱꦼꦭꦶꦫꦺ' ꦩꦺꦴꦁꦏꦺꦴ
                KeywordKeToken := 15
              ꦭꦶꦪꦤꦺ
                ꦪꦺꦤ꧀ k = 'ꦭꦏꦺꦴꦤꦶ' ꦩꦺꦴꦁꦏꦺꦴ
                  KeywordKeToken := 16
                ꦭꦶꦪꦤꦺ
                  ꦪꦺꦤ꧀ k = 'ꦏꦁꦒꦺꦴ' ꦩꦺꦴꦁꦏꦺꦴ
                    KeywordKeToken := 18
                  ꦭꦶꦪꦤꦺ
                    ꦪꦺꦤ꧀ k = 'ꦠꦸꦩꦼꦏ' ꦩꦺꦴꦁꦏꦺꦴ
                      KeywordKeToken := 21
                    ꦭꦶꦪꦤꦺ
                      ꦪꦺꦤ꧀ k = 'ꦥꦿꦺꦴꦱꦺꦢꦸꦂ' ꦩꦺꦴꦁꦏꦺꦴ
                        KeywordKeToken := 17
                      ꦭꦶꦪꦤꦺ
                        ꦪꦺꦤ꧀ k = 'ꦥ꦳ꦸꦁꦱꦶ' ꦩꦺꦴꦁꦏꦺꦴ
                          KeywordKeToken := 19
                        ꦭꦶꦪꦤꦺ
                          ꦪꦺꦤ꧀ k = 'ꦥꦿꦺꦴꦒꦿꦩ꧀' ꦩꦺꦴꦁꦏꦺꦴ
                            KeywordKeToken := 1
                          ꦭꦶꦪꦤꦺ
                            ꦪꦺꦤ꧀ k = 'ꦮꦂ' ꦩꦺꦴꦁꦏꦺꦴ
                              KeywordKeToken := 2
                            ꦭꦶꦪꦤꦺ
                              ꦪꦺꦤ꧀ k = 'ꦲꦁꦏ' ꦩꦺꦴꦁꦏꦺꦴ
                                KeywordKeToken := 22
                              ꦭꦶꦪꦤꦺ
                                ꦪꦺꦤ꧀ k = 'ꦠꦼꦩ꧀ꦧꦸꦁ' ꦩꦺꦴꦁꦏꦺꦴ
                                  KeywordKeToken := 23
                                ꦭꦶꦪꦤꦺ
                                  ꦪꦺꦤ꧀ k = 'begin' ꦩꦺꦴꦁꦏꦺꦴ
                                    KeywordKeToken := 10
                                  ꦭꦶꦪꦤꦺ
                                    ꦪꦺꦤ꧀ k = 'end' ꦩꦺꦴꦁꦏꦺꦴ
                                      KeywordKeToken := 11
                                    ꦭꦶꦪꦤꦺ
                                      ꦪꦺꦤ꧀ k = 'writeln' ꦩꦺꦴꦁꦏꦺꦴ
                                        KeywordKeToken := 20
                                      ꦭꦶꦪꦤꦺ
                                        ꦪꦺꦤ꧀ k = 'program' ꦩꦺꦴꦁꦏꦺꦴ
                                          KeywordKeToken := 1
                                        ꦭꦶꦪꦤꦺ
                                          ꦪꦺꦤ꧀ k = 'var' ꦩꦺꦴꦁꦏꦺꦴ
                                            KeywordKeToken := 2
                                          ꦭꦶꦪꦤꦺ
                                            KeywordKeToken := 99;
ꦫꦩ꧀ꦥꦸꦁ;

ꦥꦿꦺꦴꦱꦺꦢꦸꦂ NextToken;
ꦩꦸꦭꦶ
  ꦱꦼꦭꦶꦫꦺ i <= panjang ꦭꦏꦺꦴꦤꦶ
  ꦩꦸꦭꦶ
    huruf := Ambil(kode, i);
    ꦪꦺꦤ꧀ huruf = ' ' ꦩꦺꦴꦁꦏꦺꦴ
      i := i + 1
    ꦭꦶꦪꦤꦺ
      ꦪꦺꦤ꧀ huruf = Chr(10) ꦩꦺꦴꦁꦏꦺꦴ
        i := i + 1
      ꦭꦶꦪꦤꦺ
        ꦪꦺꦤ꧀ ApaAngka(huruf) = 1 ꦩꦺꦴꦁꦏꦺꦴ
          ꦩꦸꦭꦶ
            kata := '';
            ꦱꦼꦭꦶꦫꦺ i <= panjang ꦭꦏꦺꦴꦤꦶ
            ꦩꦸꦭꦶ
              huruf := Ambil(kode, i);
              ꦪꦺꦤ꧀ ApaAngka(huruf) = 1 ꦩꦺꦴꦁꦏꦺꦴ
              ꦩꦸꦭꦶ
                kata := Gabung(kata, huruf);
                i := i + 1;
              ꦫꦩ꧀ꦥꦸꦁ
              ꦭꦶꦪꦤꦺ
                i := panjang + 1;
            ꦫꦩ꧀ꦥꦸꦁ;
            curToken := 30;
            curText := kata;
            i := i + 1;
          ꦫꦩ꧀ꦥꦸꦁ
          ꦭꦶꦪꦤꦺ
            ꦪꦺꦤ꧀ ApaHuruf(huruf) = 1 ꦩꦸꦭꦶ
            ꦩꦸꦭꦶ
              kata := '';
              ꦱꦼꦭꦶꦫꦺ i <= panjang ꦭꦏꦺꦴꦤꦶ
              ꦩꦸꦭꦶ
                huruf := Ambil(kode, i);
                ꦪꦺꦤ꧀ ApaHuruf(huruf) = 1 ꦩꦺꦴꦁꦏꦺꦴ
                ꦩꦸꦭꦶ
                  kata := Gabung(kata, huruf);
                  i := i + 1;
                ꦫꦩ꧀ꦥꦸꦁ
                ꦭꦶꦪꦤꦺ
                  ꦪꦺꦤ꧀ ApaAngka(huruf) = 1 ꦩꦺꦴꦁꦏꦺꦴ
                  ꦩꦸꦭꦶ
                    kata := Gabung(kata, huruf);
                    i := i + 1;
                  ꦫꦩ꧀ꦥꦸꦁ
                  ꦭꦶꦪꦤꦺ
                    i := panjang + 1;
              ꦫꦩ꧀ꦥꦸꦁ;
              curToken := KeywordKeToken(kata);
              curText := kata;
            ꦫꦩ꧀ꦥꦸꦁ
            ꦭꦶꦪꦤꦺ
              ꦪꦺꦤ꧀ huruf = ':' ꦩꦺꦴꦁꦏꦺꦴ
                ꦪꦺꦤ꧀ Ambil(kode, i + 1) = '=' ꦩꦺꦴꦁꦏꦺꦴ
                ꦩꦸꦭꦶ
                  curToken := 40;
                  curText := ':=';
                  i := i + 2;
                ꦫꦩ꧀ꦥꦸꦁ
                ꦭꦶꦪꦤꦺ
                  curToken := 42;
                  curText := ':';
                  i := i + 1
              ꦭꦶꦪꦤꦺ
                ꦪꦺꦤ꧀ huruf = ';' ꦩꦺꦴꦁꦏꦺꦴ
                  curToken := 41;
                  curText := ';';
                  i := i + 1
                ꦭꦶꦪꦤꦺ
                  ꦪꦺꦤ꧀ huruf = '.' ꦩꦺꦴꦁꦏꦺꦴ
                    curToken := 44;
                    curText := '.';
                    i := i + 1
                  ꦭꦶꦪꦤꦺ
                    ꦪꦺꦤ꧀ huruf = '(' ꦩꦺꦴꦁꦏꦺꦴ
                      curToken := 45;
                      curText := '(';
                      i := i + 1
                    ꦭꦶꦪꦤꦺ
                      ꦪꦺꦤ꧀ huruf = ')' ꦩꦺꦴꦁꦏꦺꦴ
                        curToken := 46;
                        curText := ')';
                        i := i + 1
                      ꦭꦶꦪꦤꦺ
                        ꦪꦺꦤ꧀ huruf = '+' ꦩꦺꦴꦁꦏꦺꦴ
                          curToken := 50;
                          curText := '+';
                          i := i + 1
                        ꦭꦶꦪꦤꦺ
                          ꦪꦺꦤ꧀ huruf = '-' ꦩꦺꦴꦁꦏꦺꦴ
                            curToken := 51;
                            curText := '-';
                            i := i + 1
                          ꦭꦶꦪꦤꦺ
                            ꦪꦺꦤ꧀ huruf = '*' ꦩꦺꦴꦁꦏꦺꦴ
                              curToken := 52;
                              curText := '*';
                              i := i + 1
                            ꦭꦶꦪꦤꦺ
                              ꦪꦺꦤ꧀ huruf = '/' ꦩꦺꦴꦁꦏꦺꦴ
                                curToken := 53;
                                curText := '/';
                                i := i + 1
                              ꦭꦶꦪꦤꦺ
                                ꦪꦺꦤ꧀ huruf = '<' ꦩꦺꦴꦁꦏꦺꦴ
                                  curToken := 60;
                                  curText := '<';
                                  i := i + 1
                                ꦭꦶꦪꦤꦺ
                                  ꦪꦺꦤ꧀ huruf = '>' ꦩꦺꦴꦁꦏꦺꦴ
                                    curToken := 61;
                                    curText := '>';
                                    i := i + 1
                                  ꦭꦶꦪꦤꦺ
                                    ꦪꦺꦤ꧀ huruf = '=' ꦩꦺꦴꦁꦏꦺꦴ
                                      curToken := 62;
                                      curText := '=';
                                      i := i + 1
                                    ꦭꦶꦪꦤꦺ
                                      ꦪꦺꦤ꧀ huruf = ',' ꦩꦺꦴꦁꦏꦺꦴ
                                        curToken := 43;
                                        curText := ',';
                                        i := i + 1
                                      ꦭꦶꦪꦤꦺ
                                        curToken := 0;
                                        curText := '';
                                        i := i + 1;
              i := panjang + 1;
  ꦫꦩ꧀ꦥꦸꦁ;
ꦫꦩ꧀ꦥꦸꦁ;

ꦥꦿꦺꦴꦱꦺꦢꦸꦂ GenTipe;
ꦩꦸꦭꦶ
  ꦪꦺꦤ꧀ curToken = 22 ꦩꦺꦴꦁꦏꦺꦴ
    Emit('Integer')
  ꦭꦶꦪꦤꦺ
