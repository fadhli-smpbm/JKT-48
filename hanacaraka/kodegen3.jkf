ꦥꦿꦺꦴꦱꦺꦢꦸꦂ GenStmt;
ꦩꦸꦭꦶ
  ꦪꦺꦤ꧀ curToken = 10 ꦩꦺꦴꦁꦏꦺꦴ
    ꦩꦸꦭꦶ
      EmitLn('begin');
      NextToken;
      GenStmt;
      ꦪꦺꦤ꧀ curToken = 41 ꦩꦺꦴꦁꦏꦺꦴ
        EmitLn(';');
      NextToken;
      GenStmt;
      EmitLn('end');
    ꦫꦩ꧀ꦥꦸꦁ
  ꦭꦶꦪꦤꦺ
    ꦪꦺꦤ꧀ curToken = 20 ꦩꦺꦴꦁꦏꦺꦴ
      ꦩꦸꦭꦶ
        Emit('writeln');
        NextToken;
        Emit('(');
        NextToken;
        GenExpr;
        Emit(')');
        NextToken;
        EmitLn(';');
      ꦫꦩ꧀ꦥꦸꦁ
    ꦭꦶꦪꦤꦺ
      ꦪꦺꦤ꧀ curToken = 12 ꦩꦺꦴꦁꦏꦺꦴ
        ꦩꦸꦭꦶ
          Emit('if');
          NextToken;
          GenExpr;
          Emit('then');
          NextToken;
          GenStmt;
          ꦪꦺꦤ꧀ curToken = 14 ꦩꦺꦴꦁꦏꦺꦴ
            ꦩꦸꦭꦶ
              EmitLn('else');
              NextToken;
              GenStmt;
            ꦫꦩ꧀ꦥꦸꦁ;
        ꦫꦩ꧀ꦥꦸꦁ
      ꦭꦶꦪꦤꦺ
        ꦪꦺꦤ꧀ curToken = 15 ꦩꦺꦴꦁꦏꦺꦴ
          ꦩꦸꦭꦶ
            Emit('while');
            NextToken;
            GenExpr;
            Emit('do');
            NextToken;
            GenStmt;
