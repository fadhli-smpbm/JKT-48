{
  "Program Baru": {
    "prefix": "prog",
    "body": [
      "ꦥꦿꦺꦴꦒꦿꦩ꧀ ${1:Nama};",
      "ꦮꦂ ${2:x} : ꦲꦁꦏ;",
      "ꦩꦸꦭꦶ",
      "  ${3:x} := ${4:10};",
      "  ꦠꦸꦭꦶꦱ꧀(${3:x});",
      "ꦫꦩ꧀ꦥꦸꦁ."
    ],
    "description": "Template program Hanacaraka baru"
  },
  "If Else": {
    "prefix": "if",
    "body": [
      "ꦪꦺꦤ꧀ ${1:x} > ${2:10} ꦩꦺꦴꦁꦏꦺꦴ",
      "  ꦠꦸꦭꦶꦱ꧀(${3:1})",
      "ꦭꦶꦪꦤꦺ",
      "  ꦠꦸꦭꦶꦱ꧀(${4:0});"
    ]
  },
  "While": {
    "prefix": "while",
    "body": [
      "ꦱꦼꦭꦶꦫꦺ ${1:x} < ${2:5} ꦭꦏꦺꦴꦤꦶ",
      "ꦩꦸꦭꦶ",
      "  ${1:x} := ${1:x} + 1;",
      "  ꦠꦸꦭꦶꦱ꧀(${1:x});",
      "ꦫꦩ꧀ꦥꦸꦁ;"
    ]
  },
  "For": {
    "prefix": "for",
    "body": [
      "ꦏꦁꦒꦺꦴ ${1:i} ꦠꦸꦩꦼꦏ ${2:5} ꦭꦏꦺꦴꦤꦶ",
      "  ꦠꦸꦭꦶꦱ꧀(${1:i});"
    ]
  },
  "Function": {
    "prefix": "func",
    "body": [
      "ꦥ꦳ꦸꦁꦱꦶ ${1:Kali2}(${2:a} : ꦲꦁꦏ) : ꦲꦁꦏ;",
      "ꦩꦸꦭꦶ",
      "  ${1:Kali2} := ${2:a} * 2;",
      "ꦫꦩ꧀ꦥꦸꦁ;"
    ]
  },
  "Procedure": {
    "prefix": "proc",
    "body": [
      "ꦥꦿꦺꦴꦱꦺꦢꦸꦂ ${1:Sapa};",
      "ꦩꦸꦭꦶ",
      "  ꦠꦸꦭꦶꦱ꧀(${2:99});",
      "ꦫꦩ꧀ꦥꦸꦁ;"
    ]
  },
  "Fibonacci": {
    "prefix": "fib",
    "body": [
      "ꦥꦿꦺꦴꦒꦿꦩ꧀ Fibonacci;",
      "ꦮꦂ a, b, temp, i : ꦲꦁꦏ;",
      "ꦩꦸꦭꦶ",
      "  a := 0;",
      "  b := 1;",
      "  ꦠꦸꦭꦶꦱ꧀(a);",
      "  ꦠꦸꦭꦶꦱ꧀(b);",
      "  ꦏꦁꦒꦺꦴ i ꦠꦸꦩꦼꦏ 8 ꦭꦏꦺꦴꦤꦶ",
      "  ꦩꦸꦭꦶ",
      "    temp := a + b;",
      "    ꦠꦸꦭꦶꦱ꧀(temp);",
      "    a := b;",
      "    b := temp;",
      "  ꦫꦩ꧀ꦥꦸꦁ;",
      "ꦫꦩ꧀ꦥꦸꦁ."
    ]
  }
}